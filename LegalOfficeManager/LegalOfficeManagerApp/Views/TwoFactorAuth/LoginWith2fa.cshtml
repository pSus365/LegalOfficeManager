@{
    ViewData["Title"] = "Weryfikacja dwuetapowa";
    ViewData["HideNavbar"] = "true";
}

<h2>Weryfikacja dwuetapowa</h2>

<form asp-action="VerifyCode" method="post">
    <div class="form-group">
        <label for="code">Wpisz kod weryfikacyjny wysłany na email:</label>
        <input type="text" name="code" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Zweryfikuj</button>
</form>
